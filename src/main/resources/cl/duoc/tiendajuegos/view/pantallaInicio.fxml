<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="232.0" prefWidth="325.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.duoc.tiendajuegos.controller.PantallaInicioController">
   <children>
      <VBox layoutX="57.0" layoutY="16.0" prefHeight="200.0" prefWidth="211.0">
         <children>
            <Label text="Gestor Tienda Juegos">
               <VBox.margin>
                  <Insets bottom="10.0" left="30.0" right="10.0" top="10.0" />
               </VBox.margin></Label>
            <TextField fx:id="txtUser" promptText="Usuario">
               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin></TextField>
            <PasswordField fx:id="txtPass" promptText="Contrasena">
               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin></PasswordField>
            <Label fx:id="lblError" textFill="red" visible="false" managed="false" wrapText="true"/>
            <Button fx:id="btnIngresar" mnemonicParsing="false" text="Ingresar" onAction="#ingresar">
               <VBox.margin>
                  <Insets bottom="10.0" left="70.0" right="10.0" top="10.0" />
               </VBox.margin></Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
